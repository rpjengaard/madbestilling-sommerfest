@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Value<string>("headline") ?? Model.Name;

    var subHeadline = Model.Value<string>("subHeadline") ?? "Sommerfestival";
    var headline    = Model.Value<string>("headline") ?? "MENU";
    var supportText = Model.Value<string>("supportText") ?? "Køb, spis og støt 5. klassernes tur til Bornholm";
    var intro       = Model.Value<string>("intro") ?? "Til sommerfestival 2026 på Sdr. Bjert Skole";
    var text        = Model.Value<string>("text");

    var foodItems = Model.Children?.Where(c => c.IsVisible()) ?? Enumerable.Empty<IPublishedContent>();
}
@* [CHANGE: redesign to match A4 flyer — navy hero + peach band + outlined display type] Related: Assets/app.css, Views/Shared/_Layout.cshtml, Views/CheckoutPage.cshtml *@
<div class="grid grid-cols-[1fr_320px] gap-5 max-w-[1200px] mx-auto px-5 py-6 items-start max-lg:grid-cols-1">

    <!-- ═══════════════════════════════════════ MAIN ══ -->
    <main>

        <!-- Hero — navy band like flyer header -->
        <section class="relative overflow-hidden bg-primary rounded-t-[22px] px-8 py-10 text-center">
            <p class="text-white uppercase font-extrabold mb-4"
               style="font-size: clamp(1.25rem, 2.4vw, 1.75rem); letter-spacing: .35em;">@subHeadline</p>
            <h1 class="mx-auto leading-none"
                style="color: #F2BDB0; font-family: 'Ostrich Sans', 'Monoton', cursive; font-weight: 700; font-size: clamp(5rem, 16vw, 11rem); letter-spacing: .04em;">@headline</h1>
        </section>

        <!-- White tagline band -->
        <section class="bg-white px-6 py-4 text-center">
            <p class="display-solid tracking-[.08em]" style="font-size: 24px; color: #000;">
                @supportText
            </p>
        </section>

        <!-- Peach intro band -->
        <section class="bg-peach px-8 py-7 text-center text-primary -mt-1 mb-10 rounded-b-[22px] border-t border-white/40">
            @if (!string.IsNullOrWhiteSpace(intro))
            {
                <p class="display-solid tracking-[.12em] text-primary" style="font-size: 24px;">@intro</p>
            }
            @if (!string.IsNullOrWhiteSpace(text))
            {
                <div class="rte text-primary/80 leading-relaxed max-w-[640px] mx-auto mt-3" style="font-size: 20px;">@Html.Raw(text)</div>
            }
        </section>

        <!-- Food grid (flyer-style cards) -->
        <section class="grid grid-cols-2 gap-8 max-sm:grid-cols-1">
            @foreach (var item in foodItems)
            {
                var name        = item.Name ?? "";
                var priceRaw    = item.Value<string>("price") ?? "0";
                var price       = decimal.TryParse(priceRaw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedPrice) ? parsedPrice : 0m;
                var description = item.Value<string>("description") ?? "";
                var image       = item.Value<IPublishedContent>("image");
                var imageUrl    = image?.Url() ?? "/img/placeholder-food.jpg";
                var itemId      = item.Key.ToString();

                <article class="group bg-cream rounded-[20px] shadow-sm flex flex-col border border-peach-soft"
                         data-id="@itemId"
                         data-name="@Html.Encode(name)"
                         data-price="@price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                         data-image="@imageUrl">
                    <div class="relative w-full aspect-square bg-peach-soft">
                        <img class="w-full h-full object-cover block rounded-t-[20px] transition-transform duration-300 group-hover:scale-105"
                             src="@imageUrl" alt="@name" />
                        <!-- Blue price splash, straddling image / text seam -->
                        <div class="flyer-badge absolute right-6 -bottom-12 w-24 h-24 shadow-md z-10"
                             style="background-color: var(--color-primary);">
                            <div class="flex flex-col leading-none">
                                <span class="text-[.65rem] font-bold tracking-[.15em] opacity-90">PRIS</span>
                                <span class="display-solid text-2xl mt-1">@price.ToString("0", System.Globalization.CultureInfo.InvariantCulture) KR.</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-7 flex flex-col flex-1 gap-4">
                        <h2 class="display-solid text-primary inline-block flyer-underline"
                            style="font-size: clamp(2.4rem, 5vw, 3.4rem);">@name.ToUpper()</h2>
                        <p class="text-base text-primary/80 leading-relaxed flex-1">@description</p>
                        <button data-add-btn
                                class="flex items-center justify-center gap-2 bg-coral hover:bg-coral-hover text-white rounded-full text-base font-bold py-4 px-6 w-full transition-colors active:scale-[.98] uppercase tracking-wide"
                                onclick="FoodOrder.add(this.closest('[data-id]'))">
                            <span class="text-xl leading-none font-light">+</span>
                            Tilføj til bestilling
                        </button>
                    </div>
                </article>
            }
        </section>

        <!-- "På pladsen sælges" flyer panel -->
        <section class="bg-peach rounded-[22px] px-8 py-10 mt-10">
            <h2 class="display-solid text-primary text-center tracking-[.08em] mb-8" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem);">PÅ PLADSEN SÆLGES:</h2>

            <div class="grid grid-cols-[1fr_1fr_1fr_auto] gap-8 items-center max-md:grid-cols-2 max-sm:grid-cols-1">

                <div class="text-left">
                    <div class="border-y-2 border-coral py-2">
                        <p class="display-outline text-coral" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1;">2 Pølser<br/>med brød</p>
                    </div>
                    <p class="display-solid text-primary mt-3" style="font-size: clamp(1.6rem, 3vw, 2rem);">25 KR.</p>
                </div>

                <div class="text-left">
                    <div class="border-y-2 border-coral py-2">
                        <p class="display-outline text-coral" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1;">Kaffe<br/>&amp; the</p>
                    </div>
                    <p class="display-solid text-primary mt-3" style="font-size: clamp(1.6rem, 3vw, 2rem);">5 KR.</p>
                </div>

                <div class="text-left">
                    <div class="border-y-2 border-coral py-2">
                        <p class="display-outline text-coral" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1;">Mums<br/>kage</p>
                    </div>
                    <p class="display-solid text-primary mt-3" style="font-size: clamp(1.6rem, 3vw, 2rem);">10 KR.</p>
                </div>

                <div class="flyer-badge w-44 h-44 shadow-md justify-self-center max-md:col-span-2 max-sm:col-span-1">
                    <div class="flex flex-col gap-2 leading-tight px-2">
                        <span class="display-solid text-lg tracking-[.04em]">BETALES MED<br/>KLIPPEKORT</span>
                        <span class="text-xs font-medium normal-case opacity-95">Som du køber<br/>på pladsen i<br/>klippekortsboden</span>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ═══════════════════════════════════════ SIDEBAR ══ -->
    <aside class="lg:sticky lg:top-6 max-lg:order-first max-lg:sticky max-lg:top-3 max-lg:z-40">

        <style>
            @@media (max-width: 1023.98px) {
                #cartPanel { display: none; }
                #cartPanel.cart-mobile-open { display: flex; }
            }
        </style>

        <!-- Mobile collapsed bar (only visible <lg, only when cart has items) -->
        <div id="cartMobileBar" class="lg:hidden bg-cream border border-peach-soft shadow-md rounded-2xl" hidden>
            <button type="button" id="cartMobileToggle"
                    class="w-full flex items-center gap-3 text-left min-w-0 py-3 px-4"
                    aria-expanded="false" aria-controls="cartPanel">
                <span class="bg-coral text-white w-11 h-11 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="20" r="1.5"/>
                        <circle cx="17" cy="20" r="1.5"/>
                        <path d="M3 3h2.2l2.5 12a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L20.5 8H6.2"/>
                    </svg>
                </span>
                <span class="flex flex-col min-w-0 flex-1 gap-1.5">
                    <span class="text-[.65rem] font-semibold uppercase tracking-wide text-primary/60 leading-none">
                        <span id="cartMobileCount">0</span> varer
                    </span>
                    <span class="display-solid text-xl text-coral leading-none">
                        <span id="cartMobileTotal">0,00</span><span class="text-xs font-semibold"> kr.</span>
                    </span>
                </span>
                <svg id="cartChevron" class="w-4 h-4 text-primary transition-transform shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        <div id="cartPanel" class="bg-cream rounded-[20px] shadow-sm p-5 flex flex-col gap-4 border border-peach-soft max-lg:mt-3">

            <header class="flex items-center gap-4 pb-4 border-b border-peach-soft max-lg:hidden">
                <span class="flyer-badge w-14 h-14 shrink-0 text-[.6rem] tracking-[.1em]">
                    BESTIL
                </span>
                <h2 class="display-solid text-2xl tracking-[.04em] text-primary">DIN BESTILLING</h2>
            </header>

            <ul class="flex flex-col gap-0" id="cartList"></ul>
            <p class="text-xs text-primary/50 text-center py-2" id="cartEmpty">Din bestilling er tom.</p>

            <div class="flex flex-col gap-2 pt-3 border-t border-peach-soft" id="cartTotals" hidden>
                <div class="flex justify-between text-[.7rem] font-semibold tracking-[.06em] text-primary/60 uppercase">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">0,00 KR.</span>
                </div>
                <div class="flex justify-between items-baseline font-bold tracking-[.04em]">
                    <span class="text-sm text-primary">TOTAL</span>
                    <strong class="display-solid text-[2rem] text-coral leading-none" id="cartTotal">
                        0,00<span class="text-sm font-semibold"> kr.</span>
                    </strong>
                </div>
            </div>

            <a href="/checkout"
               id="checkoutBtn"
               hidden
               class="flex items-center justify-center gap-2 bg-coral hover:bg-coral-hover text-white rounded-full text-sm font-bold py-3 px-5 w-full transition-colors uppercase tracking-wide">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M2 10h20" stroke="currentColor" stroke-width="1.8"/>
                </svg>
                Gå til betaling
            </a>

        </div>

        <!-- Samvær credit -->
        <a href="https://www.facebook.com/p/Samv%C3%A6r-61574211925544/?locale=da_DK" target="_blank" rel="noopener"
           class="mt-6 hidden lg:flex flex-col items-center text-center text-xs text-primary/60">
            <span class="block mb-2 uppercase tracking-[.15em] font-semibold">PokeBowls leveres af</span>
            <img src="/img/samvaer-logo.png" alt="Samvær – Gastronomi, Møder, Selskaber"
                 class="w-32 h-32 rounded-full object-cover shadow-sm" />
        </a>
    </aside>

</div>

<!-- Cart item DOM template (Tailwind scans these classes) -->
<template id="cartItemTpl">
    <li class="flex items-center gap-2.5 py-3 border-b border-gray-100 last:border-0 last:pb-0 first:pt-0">
        <img class="w-11 h-11 rounded-xl object-cover shrink-0" />
        <div class="flex flex-col flex-1 min-w-0">
            <span class="text-[.8rem] font-bold truncate" data-name></span>
            <span class="text-[.65rem] text-gray-400" data-qty></span>
        </div>
        <span class="text-[.8rem] font-bold text-price whitespace-nowrap" data-price></span>
        <button class="text-gray-300 hover:text-red-500 transition-colors text-base px-1 rounded" aria-label="Fjern" data-remove>×</button>
    </li>
</template>

@section Scripts {
<script>
const FoodOrder = (() => {
    const STORAGE_KEY = 'fo_cart';
    let cart = load();

    function load() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
        catch { return []; }
    }

    function save() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    }

    function formatDKK(amount) {
        return amount.toLocaleString('da-DK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function render() {
        const list        = document.getElementById('cartList');
        const empty       = document.getElementById('cartEmpty');
        const totals      = document.getElementById('cartTotals');
        const checkout    = document.getElementById('checkoutBtn');
        const subtotalEl  = document.getElementById('cartSubtotal');
        const totalEl     = document.getElementById('cartTotal');
        const tpl         = document.getElementById('cartItemTpl');
        const mobileBar   = document.getElementById('cartMobileBar');
        const mobileCount = document.getElementById('cartMobileCount');
        const mobileTotal = document.getElementById('cartMobileTotal');
        const panel       = document.getElementById('cartPanel');

        list.innerHTML = '';

        if (cart.length === 0) {
            empty.hidden    = false;
            totals.hidden   = true;
            checkout.hidden = true;
            mobileBar.hidden = true;
            panel.classList.remove('cart-mobile-open');
            const toggle = document.getElementById('cartMobileToggle');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            return;
        }

        empty.hidden    = true;
        totals.hidden   = false;
        checkout.hidden = false;
        mobileBar.hidden = false;

        let total = 0;
        let qtyTotal = 0;

        cart.forEach(item => {
            total += item.price * item.qty;
            qtyTotal += item.qty;
            const fragment = tpl.content.cloneNode(true);
            const li  = fragment.querySelector('li');
            const img = fragment.querySelector('img');
            img.src = item.image;
            img.alt = item.name;
            fragment.querySelector('[data-name]').textContent = item.name;
            fragment.querySelector('[data-qty]').textContent  = item.qty + ' stk.';
            fragment.querySelector('[data-price]').textContent = formatDKK(item.price * item.qty) + ' kr.';
            fragment.querySelector('[data-remove]').addEventListener('click', () => remove(item.id));
            li.dataset.id = item.id;
            list.appendChild(fragment);
        });

        subtotalEl.textContent = formatDKK(total) + ' KR.';
        totalEl.innerHTML      = formatDKK(total) + '<span class="text-sm font-semibold"> kr.</span>';
        mobileCount.textContent = qtyTotal;
        mobileTotal.textContent = formatDKK(total);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const toggle  = document.getElementById('cartMobileToggle');
        const panel   = document.getElementById('cartPanel');
        const chevron = document.getElementById('cartChevron');
        if (!toggle || !panel) return;
        toggle.addEventListener('click', () => {
            const open = panel.classList.toggle('cart-mobile-open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
        });
    });

    function add(cardEl) {
        const { id, name, price, image } = cardEl.dataset;
        const existing = cart.find(i => i.id === id);
        if (existing) {
            existing.qty++;
        } else {
            cart.push({ id, name, price: parseFloat(price), image, qty: 1 });
        }
        save();
        render();
        const btn = cardEl.querySelector('[data-add-btn]');
        btn.classList.add('!bg-green-600');
        setTimeout(() => btn.classList.remove('!bg-green-600'), 600);
    }

    function remove(id) {
        cart = cart.filter(i => i.id !== id);
        save();
        render();
    }

    render();
    return { add, remove };
})();
</script>
}
